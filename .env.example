# Environment variables for Australian Electric Motor Co
# Copy to .env.local for local dev; set the real values in
# Vercel → Project → Settings → Environment Variables (all environments).

# Zoho Mail SMTP — powers the /contact/ and /wholesale/ form emails
# (app/api/contact, app/api/wholesale, lib/mailer.ts). These are server-only
# (no NEXT_PUBLIC_ prefix) so the password is never exposed to the browser.
# ZOHO_SMTP_PASSWORD must be a Zoho *app-specific* password (Zoho Mail →
# Settings → Security → App Passwords), not the account login password.
ZOHO_SMTP_USER="riders@australianelectricmotorco.com.au"
ZOHO_SMTP_PASSWORD=""

# Optional — only needed if Zoho tells you your mailbox uses a regional SMTP
# host other than the default (smtp.zoho.com). Check Zoho Mail → Settings →
# Mail Accounts → POP/IMAP for the exact host if emails fail to send.
# ZOHO_SMTP_HOST="smtp.zoho.com"

# Optional — Cloudflare Turnstile site key for form spam protection.
# Not yet wired into the form components; set this when you add it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Create a GA4 property at https://analytics.google.com → Admin → Data Streams
# → Web, then copy the Measurement ID. Set it here for local dev and in
# Vercel → Settings → Environment Variables (all environments) for production,
# then redeploy. Empty = no analytics tag is rendered at all.
NEXT_PUBLIC_GA_ID=""
